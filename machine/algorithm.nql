/* Readable version of the algorithm. The reproducible state-minimized
   compilation input is riemann.nql, which includes deliberate padding. */
global x;
global lcm;
global num;
global denom;
global i;
global c;

proc harmonic() {
    num = 0;
    denom = 1;
    while (i > 0) {
        num = num * i + denom;
        denom = denom * i;
        i = i - 1;
    }
}

proc square() {
    num = num * num;
    denom = denom * denom;
}

proc main() {
    x = x + 1;
    lcm = 1;
    i = x;
    while (i > 0) {
        num = lcm;
        denom = 0;
        while (num > 0) {
            if (denom == 0) { denom = i; }
            num = num - 1;
            denom = denom - 1;
        }
        if (denom > 0) {
            lcm = lcm + 1;
            i = x;
        } else { i = i - 1; }
    }

    i = lcm;
    harmonic();
    num = num - denom * x;
    c = denom;
    lcm = num; /* The LCM is now dead; reuse this register for the numerator. */
    i = x;
    harmonic();
    square();
    num = num * c;
    denom = denom * lcm;
    square();
    denom = denom - num * x;
    if (denom > 0) { return; }
    /* The upstream compiler repeats main automatically. */
}
