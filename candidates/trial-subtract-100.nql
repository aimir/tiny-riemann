option inplace;

global x;
global lcm;
global l;
global num;
global denom;
global i;
global c;
global d;

proc harmonic() {
    num = 0;
    denom = 1;
    while (i > 0) {
        num = num * i + denom;
        denom = denom * i;
        i = i - 1;
    }
}

proc main() {

        x = x + 1;
lcm = 1;
        i = x;
        while (i > 0) {
            c = lcm;
            while (c >= i) { c = c - i; }
            if (c > 0) { lcm = lcm + 1; i = x; }
            else { i = i - 1; }
        }
        if (true) {
            i = x;
            harmonic();
            square();
            c = num;
            d = denom;
            i = lcm;
            harmonic();
            num = (num - denom * x) * d;
            denom = denom * c;
            square();
            if (num > denom * x) {
                return;
            }
        }
}

proc square() { num = num * num; denom = denom * denom; }
