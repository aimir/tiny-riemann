option fused_decrement;

option relative_jumps;

option inplace;

global x;

global lcm;

global l;

global num;

global denom;

global i;

global c;

global d;

proc harmonic() {
    denom = (denom + 1);
    noop_0();
    while ((i > 0)) {
        num = (denom + (i * num));
        denom = (i * denom);
        i = (i - 1);
    }
}

proc main() {
    lcm = 1;
    x = (x + 1);
    i = x;
    while ((i > 0)) {
        noop_3();
        denom = 0;
        noop_1();
        num = lcm;
        noop_1();
        while ((num > 0)) {
            if ((denom == 0)) {
                denom = i;
            }
            num = (num - 1);
            denom = (denom - 1);
        }
        noop_2();
        if ((denom > 0)) {
            lcm = (lcm + 1);
            i = x;
        } else {
            noop_1();
            noop_0();
            noop_0();
            i = (i - 1);
        }
    }
    i = lcm;
    harmonic();
    num = (num - (denom * x));
    i = x;
    builtin_move(c, denom);
    builtin_move(lcm, num);
    harmonic();
    square();
    denom = (lcm * denom);
    num = (c * num);
    square();
    if ((denom > (num * x))) {
        return;
        noop_0();
    }
}

proc square() {
    denom = (denom * denom);
    num = (num * num);
}
