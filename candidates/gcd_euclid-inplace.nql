option inplace;
option implicit_halt;

global x;
global lcm;
global l;
global num;
global denom;
global i;
global c;
global d;

proc harmonic() {
    num = 0;
    denom = 1;
    while (i > 0) {
        num = num * i + denom;
        denom = denom * i;
        i = i - 1;
    }
}

proc main() {
    lcm = 1;
    while (true) {
        x = x + 1;
i = lcm;
        l = x;
        while (l > 0) {
            c = i - (i / l) * l;
            i = l;
            l = c;
        }
        lcm = lcm * (x / i);
        if (x > 253) {
            i = x;
            harmonic();
            c = num * num;
            d = denom * denom;
            i = lcm;
            harmonic();
            num = (num - denom * x) * d;
            denom = denom * c;
            if (num * num > denom * denom * x) {
                return;
            }
        }
    }
}
