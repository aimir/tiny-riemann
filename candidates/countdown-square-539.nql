option consume;
option implicit_halt;

global x;
global lcm;
global l;
global num;
global denom;
global i;
global c;
global d;

proc harmonic() {
    num = 0;
    denom = 1;
    while (i > 0) {
        num = num * i + denom;
        denom = denom * i;
        i = i - 1;
    }
}

proc main() {
    lcm = 1;
    while (true) {
        x = x + 1;
l = lcm;
        i = 1;
        while (i > 0) {
            i = x;
            c = lcm;
            while (c > 0) {
                if (i == 0) { i = x; }
                c = c - 1;
                i = i - 1;
            }
            if (i > 0) { lcm = lcm + l; }
        }
        if (x > 253) {
            i = x;
            harmonic();
            square();
            c = num;
            d = denom;
            i = lcm;
            harmonic();
            num = (num - denom * x) * d;
            denom = denom * c;
            square();
            if (num > denom * x) {
                return;
            }
        }
    }
}

proc square() { num = num * num; denom = denom * denom; }
