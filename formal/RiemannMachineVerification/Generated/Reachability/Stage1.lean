/-- [proof-guide] Reachability stage 1: the blank initial configuration satisfies the predicate.
Proof: Definitional reduction in the Lean kernel.
Role: Supplies the inductive read masks used to justify the 339-to-278-state quotient. -/
theorem inv1_initial : inv1_predicate machine339.entry (fun _ => false) = true := by rfl

/-- [proof-guide] Reachability stage 1: each permitted machine transition preserves the tape predicate.
Proof: Combines `bool_transfer_true`, `Bool.noConfusion` with the displayed local equations.
Role: Supplies the inductive read masks used to justify the 339-to-278-state quotient. -/
theorem inv1_closed : ∀ (q : Fin 339) (t : ℤ → Bool) (b : Bool),
    inv1_before q b = true → t 0 = b → inv1_predicate q t = true →
    match (machine339.transition q b).next with
    | none => True
    | some q' => inv1_predicate q' (shiftInput (machine339.transition q b).right
        (machine339.transition q b).write t) = true := by
  intro q t b hp hb hq
  fin_cases q <;> cases b
  · exact bool_transfer_true (inv1_node16 t) (inv1_node2389 t) (inv1_node16 t) (inv1_node1 t) (inv1_node1 (shiftInput true false t))
      hq (by simp [inv1_node2389, inv1_node0, inv1_node1, hb])
      (inv1_claim5 t) (inv1_claim6 t) (inv1_shift0 t)
  · exact Bool.noConfusion (show false = true from hp)
  · exact bool_transfer_true (inv1_node18 t) (inv1_node2389 t) (inv1_node2390 t) (inv1_node18 t) (inv1_node21 (shiftInput false false t))
      hq (by simp [inv1_node2389, inv1_node0, inv1_node1, hb])
      (inv1_claim9 t) (inv1_claim12 t) (inv1_shift5 t)
  · exact bool_transfer_true (inv1_node18 t) (inv1_node27 t) (inv1_node2391 t) (inv1_node1 t) (inv1_node24 (shiftInput true true t))
      hq (by simp [inv1_node27, inv1_node0, inv1_node1, hb])
      (inv1_claim13 t) (inv1_claim14 t) (inv1_shift7 t)
  · exact bool_transfer_true (inv1_node19 t) (inv1_node2389 t) (inv1_node20 t) (inv1_node19 t) (inv1_node18 (shiftInput true false t))
      hq (by simp [inv1_node2389, inv1_node0, inv1_node1, hb])
      (inv1_claim17 t) (inv1_claim20 t) (inv1_shift10 t)
  · exact bool_transfer_true (inv1_node19 t) (inv1_node27 t) (inv1_node2392 t) (inv1_node19 t) (inv1_node18 (shiftInput true false t))
      hq (by simp [inv1_node27, inv1_node0, inv1_node1, hb])
      (inv1_claim21 t) (inv1_claim22 t) (inv1_shift10 t)
  · exact bool_transfer_true (inv1_node21 t) (inv1_node2389 t) (inv1_node21 t) (inv1_node1 t) (inv1_node29 (shiftInput false true t))
      hq (by simp [inv1_node2389, inv1_node0, inv1_node1, hb])
      (inv1_claim24 t) (inv1_claim25 t) (inv1_shift12 t)
  · exact Bool.noConfusion (show false = true from hp)
